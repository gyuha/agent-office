{
  "name": "agent-office-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build:harness": "node visual/harness/build-harness.mjs",
    "test:unit": "node --experimental-strip-types --test 'unit/*.test.ts'",
    "test:visual": "npm run build:harness && playwright test",
    "test:visual:update": "npm run build:harness && playwright test --update-snapshots",
    "test": "npm run test:unit && npm run test:visual"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
