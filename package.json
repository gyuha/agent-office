{
  "name": "agent-office",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.tsx",
    "index.server.ts",
    "server/",
    "shared/",
    "!shared/state/selfcheck.ts",
    "client/*.ts",
    "client/*.tsx",
    "client/scene/index.tsx",
    "client/scene/mount-scene.ts",
    "client/scene/mount-room.ts",
    "client/scene/scheduler.ts",
    "client/scene/core/",
    "client/scene/generated/office.ts",
    "assets/CREDITS.md"
  ],
  "scripts": {
    "preversion": "npm run typecheck && npm test",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\"",
    "typecheck": "tsc --noEmit",
    "check:state": "node --experimental-strip-types shared/state/selfcheck.ts",
    "test": "node --experimental-strip-types --test 'tests/unit/*.test.ts'",
    "sprites": "node client/scene/generate-office.cjs",
    "preview": "node client/scene/build-preview.cjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
